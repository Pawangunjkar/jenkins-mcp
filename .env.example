# Jenkins Connection Details (Optional)
# If not set, the server will ask for credentials in chat via jenkins_connect tool

JENKINS_URL=http://localhost:8080
JENKINS_USERNAME=admin
JENKINS_API_TOKEN=your-api-token-here

# How to generate an API token:
# 1. Log in to Jenkins
# 2. Go to your user profile → Configure
# 3. Under "API Token", click "Add new Token"
# 4. Give it a name and click "Generate"
# 5. Copy the token and paste it here

# Credential cache directory (optional, defaults to ~/.jenkins-mcp-cache)
# JENKINS_MCP_CACHE_DIR=/custom/cache/path

# SSL verification (set to 'false' to skip SSL verification for self-signed certs)
# JENKINS_SSL_VERIFY=true

# Request timeout in seconds (default: 30)
# JENKINS_TIMEOUT=30
