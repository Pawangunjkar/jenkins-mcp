# Jenkins Connection Details
# Pass via environment variables or connect dynamically via jenkins_connect tool

JENKINS_URL=https://jenkins.example.com
JENKINS_USERNAME=admin
JENKINS_API_TOKEN=your-jenkins-api-token-here

# SSL verification (set to 'false' for self-signed certs)
JENKINS_SSL_VERIFY=true

# Request timeout in seconds (default: 30)
JENKINS_TIMEOUT=30

# Credential cache directory (optional, defaults to ~/.jenkins-mcp-cache)
# JENKINS_MCP_CACHE_DIR=/tmp/jenkins-mcp-cache
